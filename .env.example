# Kakao Maps JavaScript SDK 키 (브라우저에 노출됨 — /api/kakao-config 를 통해서만 전달)
KAKAO_JS_KEY=

# Kakao REST API 키 (서버 전용 — 절대 클라이언트로 내보내지 말 것)
KAKAO_REST_API_KEY=

# Gemini API 키 (서버 전용, AI 도우미 /api/chat 에서 사용)
GEMINI_API_KEY=

# Google Identity Services 클라이언트 ID (공개 값 — /api/google-config 를 통해 전달)
GOOGLE_CLIENT_ID=

# Neon Postgres 연결 문자열 (Vercel Postgres/Neon 대시보드에서 발급)
DATABASE_URL=

# 세션 쿠키(JWT) 서명 키 — 서버 전용. openssl rand -hex 32 등으로 생성.
SESSION_SECRET=

# Gmail SMTP (회원가입 인증번호 발송용). 없으면 서버 로그로만 대체.
# 구글 계정 → 보안 → 2단계 인증 켜기 → 앱 비밀번호 발급.
GMAIL_USER=
GMAIL_APP_PASSWORD=
