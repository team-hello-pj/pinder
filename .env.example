# Kakao Maps JavaScript SDK 키 (브라우저에 노출됨 — /api/kakao-config 를 통해서만 전달)
KAKAO_JS_KEY=

# Kakao REST API 키 (서버 전용 — 절대 클라이언트로 내보내지 말 것)
KAKAO_REST_API_KEY=

# Gemini API 키 (서버 전용, AI 도우미 /api/chat 에서 사용)
GEMINI_API_KEY=

# Google Identity Services 클라이언트 ID (공개 값 — /api/google-config 를 통해 전달)
GOOGLE_CLIENT_ID=
